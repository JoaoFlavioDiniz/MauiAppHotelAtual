<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotelAtualizado.Views.HospedagemContratada"
             Title="Resumo da Reserva"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="20" Spacing="15">

        <Label Text="{Binding QuartoSelecionado.Descricao}"
               TextColor="DarkGreen"
               FontAttributes="Bold"
               FontFamily="DancingScriptBold"
               FontSize="44"
               HorizontalTextAlignment="Center"/>

        <!-- Hóspedes -->
        <Border Padding="15" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10">
            <Grid ColumnDefinitions="*, *">
                <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="5">
                    <Label Text="Adultos:" TextColor="#475569" />
                    <Label Text="{Binding QntAdultos}" TextColor="#1E3A8A" FontAttributes="Bold" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                    <Label Text="Crianças:" TextColor="#475569" />
                    <Label Text="{Binding QntCriancas}" TextColor="#1E3A8A" FontAttributes="Bold" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Detalhes das Datas -->
        <Border Padding="15" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10">
            <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto" RowSpacing="5">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" TextColor="#475569" FontSize="12"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out:" TextColor="#475569" FontSize="12"/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia:" TextColor="#475569" FontSize="12"/>

                <Label Grid.Row="1" Grid.Column="0" 
                       Text="{Binding DataCheckIn, StringFormat='{}{0:dd/MM/yyyy}'}"
                       TextColor="#1E3A8A" FontAttributes="Bold" />

                <Label Grid.Row="1" Grid.Column="1" 
                       Text="{Binding DataCheckOut, StringFormat='{}{0:dd/MM/yyyy}'}"
                       TextColor="#1E3A8A" FontAttributes="Bold" />

                <Label Grid.Row="1" Grid.Column="2" 
                       Text="{Binding Estadia, StringFormat='{0} dia(s)'}"
                       TextColor="#1E3A8A" FontAttributes="Bold"/>
            </Grid>
        </Border>

        <!-- Valor Total -->
        <Border Padding="15" BackgroundColor="#F1F5F9" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="Valor Total:" FontSize="18" TextColor="#0F172A" VerticalOptions="Center"/>
                <Label Text="{Binding ValorTotal, StringFormat='{}{0:c}'}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1E3A8A"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                WidthRequest="180"
                HeightRequest="45"
                FontAttributes="Bold"
                FontFamily="DancingScript-Bold"
                FontSize="28"
                BackgroundColor="DarkGreen"
                TextColor="#FFFFFF"
                CornerRadius="8"
                Clicked="Button_Clicked" />
        
                     
        
    </VerticalStackLayout>
</ContentPage>