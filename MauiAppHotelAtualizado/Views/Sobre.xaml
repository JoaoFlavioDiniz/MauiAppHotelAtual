<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotelAtualizado.Views.Sobre"
             Title="Sobre" 
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Gray200}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="20"
                         Spacing="20">

        <Label Text="Sobre o App"
               FontFamily="DancingScriptBold"
               FontSize="44"
               HorizontalOptions="Center"
               TextColor="DarkGreen" />

        <Border Padding="20" Margin="10" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="15" HorizontalOptions="Center">

                <Label Text="Desenvolvedor"
                       TextTransform="Uppercase"
                       FontSize="12"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#475569"/>

                <Label Text="João Flávio Diniz" 
                       FontSize="20"
                       HorizontalOptions="Center"
                       TextColor="#0F172A"
                       FontAttributes="Bold"/>

                <Label Text="Ano de Desenvolvimento"
                       TextTransform="Uppercase"
                       FontSize="12"
                       FontAttributes="Bold"
                       Margin="0, 15, 0, 0"
                       HorizontalOptions="Center"
                       TextColor="#475569"/>

                <Label Text="2026" 
                       FontSize="20"
                       HorizontalOptions="Center"
                       TextColor="#0F172A"
                       FontAttributes="Bold"/>

                <Button Text="Voltar"
                        FontSize="28"
                        FontAttributes="Bold"
                        FontFamily="DancingScript-Bold" 
                        Margin="0, 20, 0, 0"
                        WidthRequest="150"
                        HeightRequest="45"
                        BackgroundColor="DarkGreen"
                        TextColor="#FFFFFF"
                        CornerRadius="8"
                        Clicked="OnVoltarClicked" />

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>

</ContentPage>